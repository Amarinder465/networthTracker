# Supabase credentials — required for the app to start.
# Copy this file to ".env" (same folder), fill in your values, then restart `npm run dev`.
# Get both values from your Supabase dashboard → Settings → API.
# The anon key is a public client key (safe to ship in the browser bundle).

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
